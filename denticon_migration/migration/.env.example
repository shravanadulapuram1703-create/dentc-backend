# Copy this file to .env and fill in your values
# Do NOT commit .env to version control

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_pms
DB_USER=postgres
DB_PASSWORD=your_password_here

# Path to the Denticon export folder (the folder containing all .txt files + subfolders)
DATA_SOURCE_PATH=F:\Recon Dental Data\Data Migration\Data Migration

# Denticon tenant PGID (used to seed the tenants table)
DENTICON_PGID=2829
DENTICON_TENANT_NAME=Excel Dental

# Optional: cap rows per migration step (sample / dev runs). Leave blank for full load.
# MIGRATION_MAX_ROWS=5000
