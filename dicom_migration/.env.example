# ─────────────────────────────────────────────────────────────────────────────
# DICOM migration config. Copy this file to ".env" and fill it in.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
# ─────────────────────────────────────────────────────────────────────────────

# ── SOURCE (the folder on THIS machine that holds the DICOM data) ────────────
# Point this at the top folder; sub-folders are scanned recursively.
SOURCE_DIR=C:\Users\Sravan\Downloads\1.2.840.114384.0.2019.11.13.15.52.6.50

# Which files to consider. By default we detect DICOM by its magic number, so
# files with any extension (or none) are picked up. Leave SCAN_ALL_FILES=true.
SCAN_ALL_FILES=true
FILE_EXTENSIONS=.dic,.dcm

# ── GOOGLE CLOUD STORAGE ─────────────────────────────────────────────────────
# The originals bucket (created by setup_gcp.sh) and the key prefix inside it.
GCS_BUCKET_ORIGINALS=rd-phi-dicom-originals
GCS_PREFIX=dicom

# Path to the service-account JSON key the admin gave you (ingest account).
GOOGLE_APPLICATION_CREDENTIALS=./sa-dicom-ingest.json

# ── RUN TUNING ───────────────────────────────────────────────────────────────
WORKERS=8                 # parallel uploads. 8–16 is plenty; more won't help.
MAX_BANDWIDTH_MBPS=0      # cap upload speed in megabits/sec (0 = unlimited).
                          # e.g. 20 during office hours so the clinic isn't saturated.
RETRY_MAX=6               # attempts per file before it's logged as an error.
RETRY_BASE_DELAY=1.5      # seconds; exponential backoff base.

# Where progress/state/logs/skip-lists are written (safe to keep default).
STATE_DIR=./state

# ── POSTGRES (only needed for step 03_load_staging / 04 uses GCS only) ───────
# Either set DATABASE_URL, or the DB_* parts below.
DATABASE_URL=jdbc:postgresql://35.227.92.85:5432/recondental_migrated
DB_HOST=35.227.92.85
DB_PORT=5432
DB_NAME=recondental_migrated
DB_USER=dentc_dev_user
DB_PASSWORD=Dental@recon123
