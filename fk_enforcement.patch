+
+def merge_field_catalog() -> list[dict]:
+    return [
+        {
+            "token": token,
+            "placeholder": f"#{token}#",
+            "group": group,
+            "label": label,
+            "requires_balance": token in BALANCE_TOKENS,
+            "requires_treatment_plan": token in TREATMENT_PLAN_TOKENS,
+        }
+        for token, group, label in MERGE_FIELDS
+    ]
