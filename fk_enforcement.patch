+"""letter_batch_items.patient_id nullable
+
+A batch run records one item per requested patient id, including ids that are
+not patients of the tenant. ``patient_id`` is a real foreign key, so such a
+failed row could not be stored at all (23503) and the whole run was rejected.
+The column becomes nullable; the requested id is kept in ``error``.
+
+Revision ID: cbadb3896078
+Revises: 431b5da5630e
+Create Date: 2026-09-12
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "cbadb3896078"
+down_revision = "431b5da5630e"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.alter_column("letter_batch_items", "patient_id", existing_type=sa.Integer(), nullable=True)
+
+
+def downgrade() -> None:
+    op.execute("DELETE FROM letter_batch_items WHERE patient_id IS NULL")
+    op.alter_column("letter_batch_items", "patient_id", existing_type=sa.Integer(), nullable=False)
