+# ── Formatting helpers ───────────────────────────────────────────────────────
+def _date(value: date | datetime | None) -> str:
+    """Legacy letters print US short dates; keep that, they are patient-facing."""
+    if value is None:
+        return ""
+    if isinstance(value, datetime):
+        value = value.date()
+    return value.strftime("%m/%d/%Y")
