+def tokens_in(body_html: str | None) -> list[str]:
+    """Distinct ``#TOKEN#`` names in a template body, in first-appearance order."""
+    seen: dict[str, None] = {}
+    for match in _TOKEN_RE.findall(body_html or ""):
+        seen.setdefault(match, None)
+    return list(seen)
